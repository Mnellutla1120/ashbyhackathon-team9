CROP_SIZE = 400
STRIDE = 200

os.makedirs(OUTPUT_DIR, exist_ok=True)
patches_dir = os.path.join(OUTPUT_DIR, "patches")
os.makedirs(patches_dir, exist_ok=True)

def extract_400px_grid(wsi_path, origin, roi_size, crop_size, stride):
    """
    Extracts a patch from the WSI at the specified position.

    :param wsi_path: Path to the WSI file.
    :param position: Tuple of (x, y) coordinates.
    :param patch_size: Size of the patch to extract.
    :return: Extracted patch as a PIL Image.
    """
    #try:
        # Load WSI using OpenSlide
        #wsi = openslide.OpenSlide(wsi_path)
        #x, y = int(position[0]), int(position[1])  # Convert position coordinates to integers
        #patch = wsi.read_region((x, y), 0, patch_size)  # Extract patch
        #return patch.convert("RGB")
    #except Exception as e:
        #print(f"Error extracting patch from {wsi_path} at {position}: {e}")
        #return None
    wsi = openslide.OpenSlide(wsi_path)
    ox, oy = origin
    roi_w, roi_h = roi_size
    master_roi = wsi.read_region((ox, oy), 0, (roi_w, roi_h)).convert("RGB")
    roi_save_path = os.path.join(OUTPUT_DIR, "master_patch.png")
    master_roi.save(roi_save_path)

    grid_h = (roi_h - crop_size) // stride + 1
    grid_w = (roi_w - crop_size) // stride + 1

    metadata = {
        "wsi_file": os.path.basename(wsi_path),
        "roi_origin": [ox, oy],
        "roi_dimensions": [roi_w, roi_h],
        "crop_size": crop_size,
        "stride": stride,
        "grid_shape": [grid_h, grid_w], #[7,7]
        "tiles": []
    }

    #slice 400x400 tiles
    row_idx = 0
    for y in range(0, roi_h - crop_size + 1, stride):
        col_idx = 0
        for x in range(0, roi_w - crop_size + 1, stride):
            crop = master_roi.crop((x, y, x+crop_size, y + crop_size))
            patch_name = f"{row_idx:02d}_{col_idx:02d}.png"
            crop.save(os.path.join(patches_dir, patch_name))

            metadata["tiles"].append({
                "filename": patch_name,
                "grid_row": row_idx,
                "grid_col": col_idx,
                "roi_rel_coords": [x,y],
                "abs_wsi_coords": [ox + x, oy + y]
            })
            col_idx += 1
        row_idx += 1
    meta_path = os.path.join(OUTPUT_DIR, "grid_metadata.json")
    with open(meta_path, "w") as f:
        json.dump(metadata, f, indent=2)
if __name__ == "__main__":
    extract_400px_grid(WSI_PATH, (ROI_ORIGIN_X, ROI_ORIGIN_Y), ROI_SIZE, CROP_SIZE, STRIDE)



